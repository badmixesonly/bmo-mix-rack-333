# Build trees and logs
build/
build-*/
build-*.log
cmake-build-*/

# Rendered corpora, scorecards and latency tables are regenerated by the
# tools, never committed -- the generators are the source of truth.
corpus/
renders/
reports/

# Licensed typefaces live outside the repository; see the rack's
# assets/fonts/README.md. .bmo-fontdir records where, per machine.
assets/fonts/*.otf
assets/fonts/*.ttf
.bmo-fontdir

# Planning documents and tester packages stay local
plans/
packages/
snapshots/

# Editors and OS
.DS_Store
.vscode/
.idea/
*.swp
*.log

# Frosty's field recordings for review: vocals that may not be ours to
# publish, and the fork is public. See HANDOFF.md.
field-audio/
